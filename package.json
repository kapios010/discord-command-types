{
  "name": "discord-slash-creator",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "migrator-run": "turbo run @dsc-slash/migrator#dev",
    "publish-packages": "turbo run build lint test && changeset version && changeset publish"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "github:kapios010/discord-command-types"
  },
  "contributors": [
    {
      "name": "kapios010",
      "url": "https://kapios.dev"
    }
  ],
  "keywords": [
    "discord",
    "bot",
    "commands",
    "slash",
    "slash commands",
    "interactions"
  ],
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.9.14",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@changesets/cli": "^2.29.5"
  }
}
